# Names only. Real values never go in the repository: set them in your shell,
# in your host's settings (Render or Railway), or in the Vercel project settings.

# Agents server (Render, Railway or local)
TESSERA_KEYS=            # output of `npm run keys:export`; paste only into your host's settings
SOLANA_RPC_URL=          # devnet RPC for the agents and scripts; defaults to a public endpoint
AGENT_HOST=              # public https URL of the agents server; Railway sets it by itself
WEB_ORIGINS=             # comma-separated site origins allowed by CORS, e.g. your Vercel URL
TRUST_PROXY=             # 1 behind one proxy hop (Render); Railway sets it by itself
TESSERA_ALLOW_EPHEMERAL_STATE=  # 1 on a host with no disk (Render free tier): quotes are lost on restart
CDP_API_KEY_ID=          # optional: Coinbase CDP facilitator
CDP_API_KEY_SECRET=      # optional: Coinbase CDP facilitator

# API, MCP and CLI (local, or your host)
TESSERA_RPC_URLS=        # comma-separated RPCs for the API and CLI; default the public devnet endpoint
TESSERA_API_URL=         # where the MCP server and CLI find the API; default http://127.0.0.1:4030
TESSERA_RELAY_SECRET=    # shared secret between the MCP server and the API

# Website build (public: compiled into the site, so never put a key here)
VITE_RPC_URLS=
VITE_AGENTS_URL=
